gamma_i = 3.5		# unused value (NOT marked conditionally used), source: ./BOUT.inp
lower_y = false		# unused value (NOT marked conditionally used), source: ./BOUT.inp
upper_y = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[solver]
atol = 1e-7		# unused value (NOT marked conditionally used), source: ./BOUT.inp
ksp_type = gmres		# unused value (NOT marked conditionally used), source: ./BOUT.inp
lag_jacobian = 500		# unused value (NOT marked conditionally used), source: ./BOUT.inp
max_nonlinear_iterations = 10		# unused value (NOT marked conditionally used), source: ./BOUT.inp
pc_hypre_type = euclid		# unused value (NOT marked conditionally used), source: ./BOUT.inp
pc_type = hypre		# unused value (NOT marked conditionally used), source: ./BOUT.inp
rtol = 1e-5		# unused value (NOT marked conditionally used), source: ./BOUT.inp
