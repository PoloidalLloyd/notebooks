MXG = 0		# unused value (NOT marked conditionally used), source: ./BOUT.inp
datadir = .		# type: string, source: Command line
nout = 10		# unused value (NOT marked conditionally used), source: ./BOUT.inp
optionfile = BOUT.inp		# type: string, source: default
settingsfile = BOUT.settings		# type: string, source: default
timestep = 95788 * 0.05		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[NVd+]
function = 0		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[Nd]
function = 0.001		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[Nd+]
function = 1		# unused value (NOT marked conditionally used), source: ./BOUT.inp
source_shape = H(mesh:y_xpt - y) * 1e20		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[Pd]
function = 0.0001		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[Pd+]
function = 1		# unused value (NOT marked conditionally used), source: ./BOUT.inp
powerflux = 2.5e7		# unused value (NOT marked conditionally used), source: ./BOUT.inp
source = (powerflux*2/3 / mesh:length_xpt)*H(mesh:y_xpt - y)		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[Pe]
function = `Pd+:function`		# unused value (NOT marked conditionally used), source: ./BOUT.inp
source = `Pd+:source`		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[d]
AA = 2		# unused value (NOT marked conditionally used), source: ./BOUT.inp
charge = 0		# unused value (NOT marked conditionally used), source: ./BOUT.inp
density_floor = 1e-7		# unused value (NOT marked conditionally used), source: ./BOUT.inp
diagnose = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp
thermal_conduction = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp
type = (evolve_density, evolve_pressure, evolve_momentum, noflow_boundary)		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[d+]
AA = 2		# unused value (NOT marked conditionally used), source: ./BOUT.inp
charge = 1		# unused value (NOT marked conditionally used), source: ./BOUT.inp
density_controller_i = 1e-2		# unused value (NOT marked conditionally used), source: ./BOUT.inp
density_controller_p = 5e2		# unused value (NOT marked conditionally used), source: ./BOUT.inp
density_source_positive = false		# unused value (NOT marked conditionally used), source: ./BOUT.inp
density_upstream = 5e19		# unused value (NOT marked conditionally used), source: ./BOUT.inp
diagnose = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp
noflow_lower_y = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp
noflow_upper_y = false		# unused value (NOT marked conditionally used), source: ./BOUT.inp
recycle_as = d		# unused value (NOT marked conditionally used), source: ./BOUT.inp
target_recycle = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp
target_recycle_energy = 3.5		# unused value (NOT marked conditionally used), source: ./BOUT.inp
target_recycle_multiplier = 1		# unused value (NOT marked conditionally used), source: ./BOUT.inp
thermal_conduction = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp
type = (evolve_density, evolve_pressure, evolve_momentum,noflow_boundary, upstream_density_feedback)		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[e]
AA = 1/1836		# unused value (NOT marked conditionally used), source: ./BOUT.inp
charge = -1		# unused value (NOT marked conditionally used), source: ./BOUT.inp
diagnose = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp
noflow_upper_y = false		# unused value (NOT marked conditionally used), source: ./BOUT.inp
thermal_conduction = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp
type = quasineutral, evolve_pressure, zero_current, noflow_boundary		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[electromagnetic:laplacian]
atol_accept = 1e-06		# unused value (NOT marked conditionally used), type: BoutReal, source: user_default
maxits = 1000		# unused value (NOT marked conditionally used), type: int, source: user_default
rtol_accept = 0.01		# unused value (NOT marked conditionally used), type: BoutReal, source: user_default
type = naulin		# unused value (NOT marked conditionally used), type: string, source: user_default

[hermes]
Bnorm = 1		# unused value (NOT marked conditionally used), source: ./BOUT.inp
Nnorm = 1e19		# unused value (NOT marked conditionally used), source: ./BOUT.inp
Tnorm = 100		# unused value (NOT marked conditionally used), source: ./BOUT.inp
components = (d+, d, e,sheath_boundary_simple, collisions, recycling, reactions,electron_force_balance, neutral_parallel_diffusion)		# unused value (NOT marked conditionally used), source: ./BOUT.inp
normalise_metric = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[input]
error_on_unused_options = false		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[mesh]
calcParallelSlices_on_communicate = false		# unused value (NOT marked conditionally used), type: bool, source: user_default
dymin = 0.1		# unused value (NOT marked conditionally used), source: ./BOUT.inp
file = grid_1d_minimal.nc		# unused value (NOT marked conditionally used), source: ./BOUT.inp
ixseps1 = -1		# unused value (NOT marked conditionally used), source: ./BOUT.inp
ixseps2 = -1		# unused value (NOT marked conditionally used), source: ./BOUT.inp
length_xpt = 10		# unused value (NOT marked conditionally used), source: ./BOUT.inp
source = length_xpt / mesh:length		# unused value (NOT marked conditionally used), source: ./BOUT.inp
y_xpt = pi * ( 2 - dymin - sqrt( (2-dymin)^2 - 4*(1-dymin)*source ) ) / (1 - dymin)		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[neutral_parallel_diffusion]
dneut = 10		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[reactions]
diagnose = true		# unused value (NOT marked conditionally used), source: ./BOUT.inp
type = (d + e -> d+ + 2e,d+ + e -> d,d + d+ -> d+ + d,)		# unused value (NOT marked conditionally used), source: ./BOUT.inp

[recycling]
species = d+		# unused value (NOT marked conditionally used), source: ./BOUT.inp

